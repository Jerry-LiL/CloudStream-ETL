# local writes the lake to disk. s3 lands partitions in Amazon S3 (or LocalStack).
STORAGE_BACKEND=local
LAKE_ROOT=./data/lake
SOURCE_DIR=./sample_data
LOCAL_STAGE_DIR=./data/stage

# Used only when STORAGE_BACKEND=s3. Leave the keys empty on AWS and use a role.
S3_BUCKET=cloudstream-lake
S3_PREFIX=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# http://localhost:4566 for LocalStack. Empty for real AWS.
AWS_ENDPOINT_URL=

# duckdb runs the same MERGE statements locally. snowflake is the production warehouse.
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/warehouse/cloudstream.duckdb

# Required only when WAREHOUSE_BACKEND=snowflake.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=CLOUDSTREAM
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=
